  - lineSpeaker: {fileID: 11400000, guid: 114fe42afac982e4cbc06ed49ee3c608, type: 2}
    lineEmotion: 0
    says: 'Finally home, time to play on my computer! '
    lineType: 1
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: 114fe42afac982e4cbc06ed49ee3c608, type: 2}
    lineEmotion: 2
    says: '<color=#87CEFA>(Sees a big warning sign on the screen)</color> '
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: 114fe42afac982e4cbc06ed49ee3c608, type: 2}
    lineEmotion: 0
    says: 'Huh? What''s this? '
    lineType: 1
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: f1e15e84076f2a645afad957ba79e4c1, type: 2}
    lineEmotion: 0
    says: 'Hey there, I''m Antivirius, the guardian of your digital world. '
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: 114fe42afac982e4cbc06ed49ee3c608, type: 2}
    lineEmotion: 2
    says: Whoa, you... you can talk? Mr. Antivirius?
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: 114fe42afac982e4cbc06ed49ee3c608, type: 2}
    lineEmotion: 0
    says: ' Are you from inside my computer? '
    lineType: 1
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: f1e15e84076f2a645afad957ba79e4c1, type: 2}
    lineEmotion: 0
    says: Yep, that's me!
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: f1e15e84076f2a645afad957ba79e4c1, type: 2}
    lineEmotion: 0
    says: Hear me out, there are viruses trying to mess up your computer...
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: f1e15e84076f2a645afad957ba79e4c1, type: 2}
    lineEmotion: 0
    says: and you are the only one who can defend your files and data. I need your
      help to stop them.
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: 114fe42afac982e4cbc06ed49ee3c608, type: 2}
    lineEmotion: 0
    says: 'Me? I''m just a kid. How can I stop these bad, viruses? '
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: f1e15e84076f2a645afad957ba79e4c1, type: 2}
    lineEmotion: 0
    says: You've got something special. The power to be careful and determined.
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: f1e15e84076f2a645afad957ba79e4c1, type: 2}
    lineEmotion: 0
    says: ' I''ll be your helper and give you cool tools to use when things get tricky. '
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: 114fe42afac982e4cbc06ed49ee3c608, type: 2}
    lineEmotion: 0
    says: 'Okay, but why do you need me? '
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: f1e15e84076f2a645afad957ba79e4c1, type: 2}
    lineEmotion: 0
    says: 'I keep the computer world safe, and I get stronger when people like you
      help out. We make a good team! '
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: 114fe42afac982e4cbc06ed49ee3c608, type: 2}
    lineEmotion: 0
    says: Well, I guess if it's my data, I should do something. But how do we start?
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
      animationSpeed: 0
    isChangeFontSize: 0
    fontSize: 0
    isSkippable: 1
  - lineSpeaker: {fileID: 11400000, guid: f1e15e84076f2a645afad957ba79e4c1, type: 2}
    lineEmotion: 0
    says: Thanks, that's the spirit! Together, we'll defeat the viruses and keep
      your data safe.
    lineType: 0
    hasTextEffect: 1
    textEffects:
    - TextEffectType: 0
      shakeVal: 0
      speedVal: 0
    hasCamEffect: 0
    camEffects:
      camEffectType: 0
